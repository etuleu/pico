{
  "name": "pico-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p .",
    "smoke": "node build.mjs && ../host/.build/debug/pico-cli --bundle dist --script dist/smoke.js < /dev/null"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "core-js": "3.51.0",
    "events": "3.3.0",
    "path-browserify": "1.0.1",
    "querystring-es3": "0.2.1",
    "readable-stream": "4.8.0",
    "string_decoder": "1.3.0",
    "web-streams-polyfill": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
